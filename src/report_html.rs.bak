//! Self-contained graphical HTML report generator.
//!
//! Produces `report.html`: dark-themed, zero external dependencies
//! (inline CSS + D3.js v7 + Leaflet.js + hand-rolled SVG charts), so the file
//! renders offline in any browser.

use crate::types::{GraphData, ReconResults, Severity};

pub fn html_escape(s: &str) -> String {
    let amp: &str = &['&', 'a', 'm', 'p', ';'].iter().collect::<String>();
    let lt: &str = &['&', 'l', 't', ';'].iter().collect::<String>();
    let gt: &str = &['&', 'g', 't', ';'].iter().collect::<String>();
    let quot: &str = &['&', 'q', 'u', 'o', 't', ';'].iter().collect::<String>();
    let mut out = String::with_capacity(s.len() + 16);
    for c in s.chars() {
        match c {
            '&' => out.push_str(amp),
            '<' => out.push_str(lt),
            '>' => out.push_str(gt),
            '"' => out.push_str(quot),
            _ => out.push(c),
        }
    }
    out
}

fn sev_color(s: &Severity) -> &'static str {
    match s {
        Severity::Critical => "#ef4444",
        Severity::High => "#f97316",
        Severity::Medium => "#fbbf24",
        Severity::Low => "#22d3ee",
        Severity::Info => "#64748b",
    }
}

fn sev_label(s: &Severity) -> &'static str {
    match s {
        Severity::Critical => "CRITICAL",
        Severity::High => "HIGH",
        Severity::Medium => "MEDIUM",
        Severity::Low => "LOW",
        Severity::Info => "INFO",
    }
}

/// Build the complete HTML dashboard for a finished scan.
pub fn build_html(results: &ReconResults) -> String {
    let mut h = String::with_capacity(512 * 1024);
    h.push_str(&header_block(results));
    h.push_str(&stats_block(results));
    h.push_str(&charts_block(results));
    h.push_str(&host_block(results));
    h.push_str(&attack_surface_map_block(results));
    h.push_str(&kill_chain_graph_block(results));
    h.push_str(&attack_paths_graph_block(results));
    h.push_str(&vulnerability_heatmap_block(results));
    h.push_str(&credential_map_block(results));
    h.push_str(&network_topology_block(results));
    h.push_str(&credential_heatmap_block(results));
    h.push_str(&attack_paths_graph_block_interactive(results));
    h.push_str(&vulnerability_timeline_block(results));
    h.push_str(&mitre_attack_heatmap_block(results));
    h.push_str(&remediation_priority_block(results));
    h.push_str(&evidence_explorer_block(results));

    h.push_str(&host_block(results));

    // Executive summary / AI analysis (converted markdown)
    h.push_str(&section_open("Executive Summary / Analysis", "🧠"));
    if let Some(ai) = &results.ai_report {
        h.push_str(&md_to_html(ai));
    } else {
        h.push_str("<p class='muted'>NightCrawler agent was offline — rule-based summary:</p><ul>");
        for v in results.vulns.iter().take(8) {
            h.push_str(&format!(
                "<li><span class='chip' style='background:{}'>{}</span> <b>{}</b> — {}</li>",
                sev_color(&v.severity),
                sev_label(&v.severity),
                html_escape(&v.title),
                html_escape(&v.affected)
            ));
        }
        h.push_str("</ul>");
    }
    h.push_str(&section_close());

    // Attack Paths
    h.push_str(&attack_paths_block(results));

    // Exploitation Recommendations
    h.push_str(&exploitation_recommendations_block(results));

    // API Endpoints
    h.push_str(&api_endpoints_block(results));

    // Findings
    h.push_str(&findings_block(results));

    // CVE / exploit references from the CSE
    h.push_str(&cve_block(results));
    h.push_str(&zap_block(results));

    // Ports & services
    h.push_str(&ports_block(results));

    // Web + enumeration sections
    h.push_str(&web_block(results));
    h.push_str(&enum_block(results));
    h.push_str(&dns_block(results));
    h.push_str(&osint_block(results));

    // Entity graph (legacy)
    h.push_str(&section_open("Link Analysis — Entity Graph", "🕸"));
    h.push_str(&svg_graph(&results.graph));
    h.push_str(&section_close());

    // AI decision timeline
    h.push_str(&timeline_block(results));

    h.push_str(&footer_block(results));
    wrap_document(results, h)
}

// ---------------------------------------------------------------------------
// document scaffolding with embedded D3.js v7 + Leaflet.js
// ---------------------------------------------------------------------------

fn wrap_document(results: &ReconResults, body: String) -> String {
    let target = html_escape(&results.target.input);
    format!(
        r##"<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NightCrawler — {target}</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🕷</text></svg>">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<style>
:root {{
  --bg:#0a0e14; --panel:#111827; --panel2:#0f1520; --border:#1f2b3d;
  --text:#e2e8f0; --muted:#8b9bb4; --accent:#d946ef; --cyan:#22d3ee;
  --green:#34d399; --red:#f87171; --yellow:#fbbf24; --orange:#fb923c;
}}
* {{ box-sizing:border-box; }}
body {{ margin:0; background:var(--bg); color:var(--text);
  font:15px/1.55 'Segoe UI',system-ui,-apple-system,sans-serif; }}
.wrap {{ max-width:1400px; margin:0 auto; padding:24px 20px 60px; }}
a {{ color:var(--cyan); text-decoration:none; }}
a:hover {{ text-decoration:underline; }}
.banner {{ background:linear-gradient(120deg,#1b0b23 0%,#0a1a2e 60%,#0a0e14 100%);
  border:1px solid #2c1f3d; border-radius:14px; padding:26px 28px; margin-bottom:22px;
  position:relative; overflow:hidden; }}
.banner h1 {{ margin:0 0 6px; font-size:26px; letter-spacing:.5px;
  background:linear-gradient(90deg,#e879f9,#22d3ee); -webkit-background-clip:text;
  background-clip:text; color:transparent; }}
.banner .sub {{ color:var(--muted); font-size:14px; }}
.banner .meta {{ display:flex; gap:18px; flex-wrap:wrap; margin-top:14px; font-size:13px;
  color:#b7c3d7; }}
.banner .meta b {{ color:#fff; }}
.cards {{ display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-bottom:22px; }}
.card {{ background:var(--panel); border:1px solid var(--border); border-radius:12px;
  padding:14px 16px; }}
.card .num {{ font-size:26px; font-weight:700; }}
.card .lbl {{ color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:1px; }}
.section {{ background:var(--panel2); border:1px solid var(--border); border-radius:14px;
  padding:20px 22px; margin-bottom:18px; }}
.section>h2 {{ margin:0 0 12px; font-size:18px; color:#cbd5e1;
  border-bottom:1px solid var(--border); padding-bottom:10px; }}
table {{ width:100%; border-collapse:collapse; font-size:13.5px; margin:8px 0; }}
th {{ text-align:left; color:#93a6c1; font-weight:600; padding:8px 10px;
  border-bottom:2px solid var(--border); font-size:12.5px; text-transform:uppercase; letter-spacing:.5px; }}
td {{ padding:7px 10px; border-bottom:1px solid #17202e; vertical-align:top; }}
tr:hover td {{ background:#0d1420; }}
.chip {{ display:inline-block; padding:2px 8px; border-radius:20px; font-size:11px;
  font-weight:700; color:#0a0e14; letter-spacing:.5px; }}
.muted {{ color:var(--muted); }}
.finding {{ background:var(--panel); border:1px solid var(--border); border-left:4px solid #333;
  border-radius:10px; padding:14px 16px; margin:10px 0; }}
.finding h3 {{ margin:0 0 8px; font-size:15.5px; }}
.finding .meta {{ color:var(--muted); font-size:12.5px; margin-bottom:6px; }}
.finding pre {{ background:#0a0e14; border:1px solid #17202e; padding:10px;
  border-radius:8px; overflow-x:auto; font-size:12.5px; }}
code {{ background:#1a2332; padding:1px 5px; border-radius:5px; font-size:12.5px; color:#a5f3fc; }}
details {{ margin:10px 0; }}
details summary {{ cursor:pointer; color:#cbd5e1; font-weight:600; padding:6px 0; }}
.donut-legend span {{ margin-right:14px; font-size:13px; }}
.flex {{ display:flex; gap:26px; flex-wrap:wrap; align-items:center; }}
.bars {{ margin-top:10px; }}
.bar-row {{ display:flex; align-items:center; gap:10px; margin:5px 0; }}
.bar-lbl {{ width:110px; color:var(--muted); font-size:12.5px; text-align:right; }}
.bar-track {{ flex:1; background:#0a0e14; border-radius:6px; height:16px; overflow:hidden; }}
.bar-fill {{ height:100%; border-radius:6px; }}
.foot {{ color:var(--muted); font-size:12px; text-align:center; margin-top:26px; }}
h3.sub {{ color:#e879f9; margin:18px 0 8px; }}
@media (max-width:760px) {{ .banner .meta {{ gap:10px; }} }}

/* D3.js Visualization Styles */
#attack-surface-map, #kill-chain-graph, #attack-path-graph, #vuln-heatmap,
#credential-map, #network-topology, #cred-heatmap, #attack-path-interactive,
#vuln-timeline, #mitre-heatmap, #remediation-matrix, #evidence-explorer {{
  background:#0a0e14; border:1px solid #17202e; border-radius:10px;
}}
.tooltip {{ position:absolute; pointer-events:none; background:#111827; border:1px solid #374151;
  padding:8px 12px; border-radius:6px; font-size:12px; color:#e2e8f0;
  pointer-events:none; z-index:1000; }}
.node {{ cursor:pointer; }}
.node:hover {{ stroke:#fff; stroke-width:2px; }}
.link {{ stroke:#2b3a52; stroke-width:1.3px; }}
.node text {{ pointer-events:none; font-size:11px; fill:#dbe4f0; }}
.heatmap-cell {{ cursor:pointer; }}
.heatmap-cell:hover {{ stroke:#fff; stroke-width:1px; }}
.timeline-event {{ cursor:pointer; }}
.timeline-event:hover {{ stroke:#fff; stroke-width:2px; }}
.node-attack {{ fill:#ef4444; }}
.node-recon {{ fill:#22d3ee; }}
.node-exploit {{ fill:#f97316; }}
.node-lateral {{ fill:#fbbf24; }}
.node-persist {{ fill:#e879f9; }}
.node-impact {{ fill:#f87171; }}
.node-cred {{ fill:#34d399; }}
.legend-item {{ display:inline-flex; align-items:center; margin-right:16px; font-size:12px; }}
.legend-color {{ width:12px; height:12px; border-radius:3px; margin-right:6px; }}
.viz-container {{ position:relative; width:100%; }}
.viz-title {{ font-size:14px; font-weight:600; color:#cbd5e1; margin-bottom:8px; display:flex; align-items:center; gap:8px; }}
.viz-controls {{ display:flex; gap:8px; margin-bottom:12px; flex-wrap:wrap; }}
.viz-btn {{ background:#1f2937; border:1px solid #374151; color:#e2e8f0; padding:6px 12px;
  border-radius:6px; font-size:11px; cursor:pointer; }}
.viz-btn:hover {{ background:#374151; }}
.viz-btn.active {{ background:#d946ef; border-color:#d946ef; }}
.legend-item {{ display:inline-flex; align-items:center; margin-right:16px; font-size:12px; }}
.legend-color {{ width:12px; height:12px; border-radius:3px; margin-right:6px; }}
.attack-path-node {{ cursor:pointer; }}
.attack-path-node:hover {{ stroke:#fff; stroke-width:2px; }}
.attack-path-step {{ cursor:pointer; }}
.attack-path-step:hover {{ background:#1f2937; }}
.heatmap-legend {{ display:flex; gap:16px; margin-top:8px; flex-wrap:wrap; }}
.mitre-tactic {{ cursor:pointer; }}
.mitre-tactic:hover {{ stroke:#fff; stroke-width:2px; }}
.evidence-row:hover {{ background:#1f2937; }}
#evidence-search {{ width:100%; padding:8px 12px; background:#0a0e14; border:1px solid #374151;
  border-radius:6px; color:#e2e8f0; margin-bottom:12px; font-size:13px; }}
</style>
</head>
<body><div class="wrap">
{body}
</div>

<!-- Embedded D3.js v7 -->
<script src="https://d3js.org/d3.v7.min.js"></script>
<!-- Embedded Leaflet.js -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
// Global data store
const REPORT_DATA = {REPORT_DATA_JSON};

// Global tooltip
const tooltip = d3.select("body").append("div")
  .attr("class", "tooltip")
  .style("opacity", 0);

function showTooltip(event, html) {{
  tooltip.html(html)
    .style("left", (event.pageX + 10) + "px")
    .style("top", (event.pageY - 28) + "px")
    .style("opacity", 1);
}}

function hideTooltip() {{
  tooltip.style("opacity", 0);
}}

// Global filter state
let vulnFilter = {{ severity: "all", type: "all" }};
let mitreFilter = {{ tactic: "all" }};
let timelineFilter = {{ phase: "all" }};
let attackPathFilter = {{ severity: "all" }};
let vulnSearch = "";

// Initialize all visualizations
document.addEventListener("DOMContentLoaded", function() {{
  initAttackSurfaceMap();
  initKillChainGraph();
  initAttackPathGraph();
  initVulnHeatmap();
  initCredentialMap();
  initNetworkTopology();
  initCredentialHeatmap();
  initAttackPathInteractive();
  initVulnTimeline();
  initMitreHeatmap();
  initRemediationMatrix();
  initEvidenceExplorer();
  setupFilters();
}});

function setupFilters() {{
  // Vulnerability heatmap filters
  document.querySelectorAll(".vuln-filter-sev").forEach(el => {{
    el.addEventListener("change", function() {{
      vulnFilter.severity = this.value;
      updateVulnHeatmap();
    }});
  }});
  document.querySelectorAll(".vuln-filter-type").forEach(el => {{
    el.addEventListener("change", function() {{
      vulnFilter.type = this.value;
      updateVulnHeatmap();
    }});
  }});

  // MITRE heatmap filter
  document.querySelectorAll(".mitre-filter-tactic").forEach(el => {{
    el.addEventListener("change", function() {{
      mitreFilter.tactic = this.value;
      updateMitreHeatmap();
    }});
  }});

  // Timeline filter
  document.querySelectorAll(".timeline-filter-phase").forEach(el => {{
    el.addEventListener("change", function() {{
      timelineFilter.phase = this.value;
      updateVulnTimeline();
    }});
  }});

  // Attack path filter
  document.querySelectorAll(".attack-path-filter-sev").forEach(el => {{
    el.addEventListener("change", function() {{
      attackPathFilter.severity = this.value;
      updateAttackPathInteractive();
    }});
  }});

  // Evidence search
  const searchInput = document.getElementById("evidence-search");
  if (searchInput) {{
    searchInput.addEventListener("input", function() {{
      vulnSearch = this.value.toLowerCase();
      filterEvidenceTable();
    }});
  }}
}}

// Data accessor
function getData() {{
  return REPORT_DATA;
}}

</script>
</body></html>"##,
        target = target,
        body = body,
        REPORT_DATA_JSON = serde_json::to_string(results).unwrap_or_default()
    )
}

// =============================================================================
// VISUALIZATION BLOCKS - Advanced D3.js Interactive Visualizations
// =============================================================================

// ---------------------------------------------------------------------------
// Header Block
// ---------------------------------------------------------------------------
fn header_block(results: &ReconResults) -> String {
    let model = results
        .ai_model
        .as_deref()
        .unwrap_or("offline (tools-only)");
    format!(
        r#"<div class="banner">
<h1>🕷 NightCrawler — Adversary Simulation Report</h1>
<div class="sub">Autonomous agent · governed by the AGENTS.md adversary simulation doctrine</div>
<div class="meta">
  <span>Target: <b>{}</b></span>
  <span>Started: <b>{}</b></span>
  <span>Duration: <b>{}s</b></span>
  <span>Agent model: <b>{}</b></span>
  <span>Recursion depth: <b>{}</b></span>
</div>
</div>"#,
        html_escape(&results.target.input),
        html_escape(&results.meta.started_at),
        results.meta.duration_secs,
        html_escape(model),
        results.ai_decisions.len()
    )
}

// ---------------------------------------------------------------------------
// Stats Block
// ---------------------------------------------------------------------------
fn stats_block(results: &ReconResults) -> String {
    let open = results.ports.iter().filter(|p| p.open).count();
    let crit = results.vulns.iter().filter(|v| v.severity == Severity::Critical).count();
    let high = results.vulns.iter().filter(|v| v.severity == Severity::High).count();
    let med = results.vulns.iter().filter(|v| v.severity == Severity::Medium).count();
    let low = results.vulns.iter().filter(|v| v.severity == Severity::Low).count();
    let cve_refs: usize = results.cve_refs.iter().map(|r| r.results.len()).sum();
    let card = |num: String, lbl: &str, color: &str| {
        format!(
            r#"<div class="card"><div class="num" style="color:{}">{}</div><div class="lbl">{}</div></div>"#,
            color, num, lbl
        )
    };
    format!(
        "{}{}{}{}{}{}{}{}{}{}",
        card(open.to_string(), "open ports", "#22d3ee"),
        card(results.subdomains.len().to_string(), "subdomains", "#34d399"),
        card(results.subdirs.len().to_string(), "web paths", "#34d399"),
        card(crit.to_string(), "critical", "#ef4444"),
        card(high.to_string(), "high", "#f97316"),
        card(med.to_string(), "medium", "#fbbf24"),
        card(results.vulns.iter().filter(|v| v.severity == Severity::Low).count().to_string(), "low", "#22d3ee"),
        card(cve_refs.to_string(), "cve refs (CSE)", "#d946ef"),
        card(results.graph.nodes.len().to_string(), "graph entities", "#8b9bb4"),
        card(results.ai_decisions.len().to_string(), "AI decisions", "#e879f9"),
    )
}

// ---------------------------------------------------------------------------
// Charts Block
// ---------------------------------------------------------------------------
fn charts_block(results: &ReconResults) -> String {
    let mut crit = 0;
    let mut high = 0;
    let mut med = 0;
    let mut low = 0;
    let mut info = 0;
    for v in &results.vulns {
        match v.severity {
            Severity::Critical => crit += 1,
            Severity::High => high += 1,
            Severity::Medium => med += 1,
            Severity::Low => low += 1,
            Severity::Info => info += 1,
        }
    }
    let segs = [
        ("Critical", crit, "#ef4444"),
        ("High", high, "#f97316"),
        ("Medium", med, "#fbbf24"),
        ("Low", low, "#22d3ee"),
        ("Info", info, "#475569"),
    ];
    let total: usize = segs.iter().map(|s| s.1).sum();
    let (donut_svg, legend) = svg_donut(&segs, total);

    // Port distribution chart
    let port_chart = port_dist_chart(results);
    
    // ZAP risk chart
    let zap_chart = zap_risk_chart(results);

    format!(
        r#"<div class="section"><h2>📊 Findings Overview</h2>
<div class="flex">
  <div>{}</div>
  <div class="donut-legend">{}</div>
  <div style="flex:1;min-width:280px"><h3 class="sub">Top finding areas</h3><div class="bars">{}</div></div>
</div>
<div class="flex" style="margin-top:16px">
  <div style="flex:1;min-width:280px">{}</div>
  <div style="flex:1;min-width:280px">{}</div>
</div>
</div>"#,
        donut_svg, legend,
        format!("{}", build_finding_area_bars(results)),
        port_dist_chart(results),
        zap_risk_chart(results)
    )
}

fn build_finding_area_bars(results: &ReconResults) -> String {
    let mut cats: Vec<(String, usize)> = Vec::new();
    for v in &results.vulns {
        let k = v.title.split('—').next().unwrap_or(&v.title).trim().to_string();
        let key = if k.len() > 22 { format!("{}…", k.chars().take(21).collect::<String>()) } else { k };
        if let Some(e) = cats.iter_mut().find(|(k2, _)| *k2 == key) {
            e.1 += 1;
        } else {
            cats.push((key, 1));
        }
    }
    cats.sort_by(|a, b| b.1.cmp(&a.1));
    cats.truncate(8);
    let maxc = cats.iter().map(|c| c.1).max().unwrap_or(1);
    let mut bars = String::new();
    for (name, n) in &cats {
        bars += &format!(
            r##"<div class="bar-row"><div class="bar-lbl">{}</div><div class="bar-track"><div class="bar-fill" style="width:{}%;background:linear-gradient(90deg,#d946ef,#8b5cf6)"></div></div><div class="muted">{}</div></div>"##,
            html_escape(name), (n * 100 / maxc), n
        );
    }
    bars
}

// ---------------------------------------------------------------------------
// Charts
// ---------------------------------------------------------------------------

/// Port distribution chart (which ports are open and their categories).
fn port_dist_chart(results: &ReconResults) -> String {
    let mut h = String::from("<h3 class='sub'>Open Ports by Service Category</h3>");
    let categories = [
        ("Web (HTTP/S)", vec![80u16, 443, 2052, 2053, 2082, 2083, 2086, 2087, 2095, 2096, 8080, 8081, 8443, 8880, 3000, 5000, 7000, 7777, 9090, 10000]),
        ("Mail", vec![25, 110, 143, 465, 587, 993, 995]),
        ("Database", vec![1433, 1521, 3306, 5432, 6379, 9200, 27017, 11211]),
        ("File/Print", vec![21, 69, 139, 445, 515, 2049]),
        ("Remote Access", vec![22, 23, 3389, 5900, 5901, 5800]),
        ("Directory/LDAP", vec![88, 389, 464, 636, 3268, 3269]),
        ("Admin/Mgmt", vec![8080, 8081, 8443, 10000, 10050, 10051]),
    ];
    let mut max = 0;
    let mut counts: Vec<(&str, usize)> = Vec::new();
    for (name, plist) in &categories {
        let c = results.ports.iter()
            .filter(|p| p.open && plist.contains(&p.port))
            .count();
        if c > 0 { counts.push((name, c)); max = std::cmp::max(max, c); }
    }
    let uncat = results.ports.iter()
        .filter(|p| p.open && !categories.iter().any(|(_, pl)| pl.contains(&p.port)))
        .count();
    if uncat > 0 { counts.push(("Other", uncat)); max = std::cmp::max(max, uncat); }
    if max == 0 { return "<p class='muted'>No open ports.</p>".into(); }
    for (name, n) in &counts {
        let color = match *name {
            "Web (HTTP/S)" => "#22d3ee",
            "Mail" => "#34d399",
            "Database" => "#ef4444",
            "File/Print" => "#f97316",
            "Remote Access" => "#e879f9",
            "Directory/LDAP" => "#fbbf24",
            _ => "#64748b",
        };
        h += &format!(
            r#"<div class="bar-row"><div class="bar-lbl">{}</div><div class="bar-track"><div class="bar-fill" style="width:{}%;background:{}"></div></div><div class="muted">{}</div></div>"#,
            html_escape(name), (n * 100 / max), color, n
        );
    }
    h
}

/// ZAP risk breakdown (horizontal bars per risk level).
fn zap_risk_chart(results: &ReconResults) -> String {
    let all: Vec<&crate::types::WebAlert> = results.webscan.iter().flat_map(|s| s.alerts.iter()).collect();
    if all.is_empty() { return String::new(); }
    let mut hi = 0; let mut med = 0; let mut lo = 0; let mut info = 0;
    for a in &all {
        match a.risk.as_str() {
            "High" => hi += 1,
            "Medium" => med += 1,
            "Low" => lo += 1,
            _ => info += 1,
        }
    }
    let max = std::cmp::max(std::cmp::max(std::cmp::max(hi, med), lo), info).max(1);
    let mut h = String::from("<h3 class='sub'>ZAP Alerts by Risk</h3>");
    for (label, n, color) in [("High", hi, "#ef4444"), ("Medium", med, "#f97316"), ("Low", lo, "#fbbf24"), ("Info", info, "#64748b")] {
        h += &format!(
            r#"<div class="bar-row"><div class="bar-lbl">{} alert</div><div class="bar-track"><div class="bar-fill" style="width:{}%;background:{}"></div></div><div class="muted">{}</div></div>"#,
            label, if n > 0 { n * 100 / max } else { 0 }, color, n
        );
    }
    h
}

fn svg_donut(segs: &[(&str, usize, &str)], total: usize) -> (String, String) {
    let r = 70f64;
    let c = 2.0 * std::f64::consts::PI * r;
    let mut offset = 0.0;
    let mut svg = format!(
        r#"<svg width="190" height="190" viewBox="0 0 190 190"><g transform="translate(95,95) rotate(-90)">"#
    );
    if total == 0 {
        svg += &format!(
            r##"<circle r="{}" fill="none" stroke="#1f2b3d" stroke-width="26"/>"##,
            r
        );
    }
    for (name, n, color) in segs {
        if *n == 0 { continue; }
        let len = c * (*n as f64) / total as f64;
        svg += &format!(
            r#"<circle r="{r}" fill="none" stroke="{color}" stroke-width="26" stroke-dasharray="{len:.1} {rest:.1}" stroke-dashoffset="-{offset:.1}"><title>{name}: {n}</title></circle>"##,
            r = r,
            color = color,
            len = len,
            rest = c - len,
            offset = offset,
            name = name,
            n = n
        );
        offset += len;
    }
    svg += &format!(
        r##"</g><text x="95" y="90" text-anchor="middle" fill="#e2e8f0" font-size="26" font-weight="700">{}</text><text x="95" y="110" text-anchor="middle" fill="#8b9bb4" font-size="11">VULN FINDINGS</text></svg>"##,
        total
    );
    let legend: String = segs
        .iter()
        .map(|(name, n, color)| {
            format!(
                r#"<span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:{};margin-right:5px"></span>{} ({})</span>"#,
                color, name, n
            )
        })
        .collect();
    (svg, legend)
}

/// SVG Entity Graph (Layered)
fn svg_graph(graph: &GraphData) -> String {
    let kind_col = |k: &str| match k {
        "domain" | "subdomain" => 0,
        "org" | "email" | "user" | "host" => 1,
        "ip" => 2,
        "service" => 3,
        _ => 4,
    };
    let node_color = |k: &str| match k {
        "domain" | "subdomain" => "#4c6ef5",
        "org" => "#9c36b5",
        "email" => "#d6336c",
        "ip" => "#12b886",
        "service" => "#e8590c",
        "user" | "host" => "#f59f00",
        _ => "#3b5bdb",
    };

    let max_nodes = 120usize;
    let nodes: Vec<&crate::types::GNode> = if graph.nodes.len() > max_nodes {
        let mut deg: std::collections::HashMap<usize, usize> = std::collections::HashMap::new();
        for e in &graph.edges {
            *deg.entry(e.from).or_insert(0) += 1;
            *deg.entry(e.to).or_insert(0) += 1;
        }
        let mut ranked: Vec<&crate::types::GNode> = graph.nodes.iter().collect();
        ranked.sort_by_key(|n| std::cmp::Reverse(deg.get(&n.id).copied().unwrap_or(0)));
        ranked.into_iter().take(max_nodes).collect()
    } else {
        graph.nodes.iter().collect()
    };
    let keep: std::collections::HashSet<usize> = nodes.iter().map(|n| n.id).collect();

    let col_w = 280.0;
    let node_h = 32.0;
    let gap_y = 16.0;
    let mut col_counts = [0usize; 5];
    let mut pos: std::collections::HashMap<usize, (f64, f64)> = std::collections::HashMap::new();
    for n in &nodes {
        let col = kind_col(&n.kind);
        let x = 24.0 + col as f64 * col_w;
        let y = 24.0 + col_counts[col] as f64 * (node_h + gap_y);
        col_counts[col] += 1;
        pos.insert(n.id, (x, y));
    }
    let height = col_counts.iter().copied().max().unwrap_or(1) as f64 * (node_h + gap_y) + 40.0;
    let width = 5.0 * col_w + 40.0;

    let mut svg = format!(
        r##"<svg viewBox="0 0 {w} {h}" width="100%" style="max-height:{h}px;background:#0a0e14;border:1px solid #17202e;border-radius:10px">"##,
        w = width,
        h = height
    );
    // edges first
    let mut drawn = 0;
    for e in &graph.edges {
        if drawn > 300 { break; }
        if let (Some((x1, y1)), Some((x2, y2))) = (pos.get(&e.from), pos.get(&e.to)) {
            let mx = (x1 + x2) / 2.0;
            svg += &format!(
                r##"<path d="M {x1e} {y1e} C {mx} {y1e}, {mx} {y2e}, {x2e} {y2e}" fill="none" stroke="#2b3a52" stroke-width="1.3"><title>{lbl}</title></path>"##,
                x1e = x1 + 220.0,
                y1e = y1 + node_h / 2.0,
                x2e = x2,
                y2e = y2 + node_h / 2.0,
                mx = mx + 100.0,
                lbl = html_escape(&e.label)
            );
            drawn += 1;
        }
    }
    // nodes
    for n in &nodes {
        let (x, y) = pos[&n.id];
        let color = node_color(&n.kind);
        let label: String = n.label.chars().take(30).collect();
        let tx = x + 10.0;
        let ty = y + 20.0;
        svg += &format!(
            r##"<g><rect x="{x}" y="{y}" width="220" height="{nh}" rx="7" fill="#111826" stroke="{color}" stroke-width="1.4"/>
<text x="{tx}" y="{ty}" font-size="12" fill="#dbe4f0">{lbl} <tspan fill="#5b6b82" font-size="10">[{kind}]</tspan></text></g>"##,
            x = x,
            y = y,
            nh = node_h,
            color = color,
            tx = tx,
            ty = ty,
            lbl = html_escape(&label),
            kind = html_escape(&n.kind)
        );
    }
    svg += "</svg>";
    if graph.nodes.len() > max_nodes {
        svg += &format!(
            "<p class='muted'>Graph truncated to the {} most connected of {} entities.</p>",
            max_nodes,
            graph.nodes.len()
        );
    }
    svg
}

// =============================================================================
// Advanced D3.js Visualization Blocks
// =============================================================================

/// Attack Surface Map - D3.js Force-Directed Graph
fn attack_surface_map_block(results: &ReconResults) -> String {
    let mut h = String::from(r#"<div class="section"><h2>🗺️ Attack Surface Map (Interactive)</h2>"#);
    h += r#"<div class="viz-controls">
  <label class="viz-btn" onclick="filterAttackSurface('all')">All</label>
  <label class="viz-btn" onclick="filterAttackSurface('web')">Web</label>
  <label class="viz-btn" onclick="filterAttackSurface('api')">API</label>
  <label class="viz-btn" onclick="filterAttackSurface('infra')">Infra</label>
  <label class="viz-btn" onclick="filterAttackSurface('cred')">Credentials</label>
</div>"#;
    h += r#"<div id="attack-surface-map" class="viz-container" style="height:600px;"></div>"#;
    h += &section_close();

    // Inject data and D3.js code
    let nodes_json = serde_json::to_string(&build_attack_surface_nodes(results)).unwrap_or_default();
    let links_json = serde_json::to_string(&build_attack_surface_links(results)).unwrap_or_default();

    h += &format!(r#"
<script>
const attackSurfaceNodes = {};
const attackSurfaceLinks = {};
let attackSurfaceSimulation;

function initAttackSurfaceMap() {{
  const container = d3.select("#attack-surface-map");
  const width = container.node().getBoundingClientRect().width;
  const height = 600;

  const svg = container.append("svg")
    .attr("width", "100%")
    .attr("height", "600")
    .attr("viewBox", `0 0 ${{width}} ${{height}}`);

  // Definitions for gradients and markers
  const defs = svg.append("defs");
  
  // Arrow markers for links
  ["recon", "exploit", "lateral", "persist", "impact", "cred", "default"].forEach((type, i) => {{
    const colors = {{recon: "#22d3ee", exploit: "#ef4444", lateral: "#f97316", persist: "#e879f9", impact: "#f87171", cred: "#34d399", default: "#64748b"}};
    const color = colors[type] || colors.default;
    svg.append("defs").append("marker")
      .attr("id", `arrowhead-${{type}}`)
      .attr("viewBox", "0 0 10 10")
      .attr("refX", 16)
      .attr("refY", 5)
      .attr("markerWidth", 6)
      .attr("markerHeight", 6)
      .attr("orient", "auto")
      .append("path")
      .attr("d", "M 0 0 L 10 5 L 0 10 Z")
      .attr("fill", colors[type]);
  }};

  const simulation = d3.forceSimulation()
    .force("link", d3.forceLink().id(d => d.id).distance(120).strength(0.3))
    .force("charge", d3.forceManyBody().strength(-400))
    .force("center", d3.forceCenter(0, 0))
    .force("collision", d3.forceCollide().radius(40).strength(0.5))
    .force("x", d3.forceX(0).strength(0.1))
    .force("y", d3.forceY(0).strength(0.1));

  const link = svg.append("g")
    .attr("stroke", "#2b3a52")
    .attr("stroke-width", 1.5)
    .selectAll("path")
    .data(attackSurfaceLinks)
    .join("path")
    .attr("class", "link")
    .attr("marker-end", d => `url(#arrowhead-${{d.type || "default"}})`);

  const node = svg.append("g")
    .attr("stroke", "#fff")
    .attr("stroke-width", 1.5)
    .selectAll("g")
    .data(attackSurfaceNodes)
    .join("g")
    .attr("class", "node")
    .call(drag(simulation))
    .on("mouseover", function(event, d) {{
      showTooltip(event, `<strong>${{d.label}}</strong><br>Type: ${{d.kind}}${{d.severity ? `<br>Severity: ${{d.severity}}` : ""}}${{d.port ? `<br>Port: ${{d.port}}` : ""}}${{d.service ? `<br>Service: ${{d.service}}` : ""}}`);
    }})
    .on("mouseout", hideTooltip)
    .on("click", function(event, d) {{
      if (d.url) window.open(d.url, "_blank");
    }});

  const nodeCircle = node.append("circle")
    .attr("r", d => Math.max(12, Math.min(30, 10 + (d.degree || 0) * 2)))
    .attr("fill", d => {{
      const colors = {{recon: "#22d3ee", exploit: "#ef4444", lateral: "#f97316", persist: "#e879f9", impact: "#f87171", cred: "#34d399", web: "#e879f9", api: "#f97316", infra: "#fbbf24", default: "#64748b"}};
      return colors[d.kind] || colors.default;
    }})
    .attr("stroke", "#fff")
    .attr("stroke-width", 1.5);

  const nodeLabel = node.append("text")
    .attr("dy", d => 20 + Math.max(12, Math.min(30, 10 + (d.degree || 0) * 2)))
    .attr("text-anchor", "middle")
    .attr("font-size", "10px")
    .attr("fill", "#dbe4f0")
    .attr("font-weight", 500)
    .text(d => d.label.length > 20 ? d.label.substring(0, 18) + "…" : d.label);

  attackSurfaceSimulation = simulation
    .nodes(attackSurfaceNodes)
    .on("tick", ticked);

  simulation.force("link")
    .links(attackSurfaceLinks);

  function ticked() {{
    link.attr("d", d => {{
      const dx = d.target.x - d.source.x;
      const dy = d.target.y - d.source.y;
      const dr = Math.sqrt(dx * dx + dy * dy);
      return `M${{d.source.x}},${{d.source.y}}A${{dr}},${{dr}} 0 0,1 ${{d.target.x}},${{d.target.y}}`;
    }});

    node.attr("transform", d => `translate(${{d.x}},${{d.y}})`);
  }}

  function drag(simulation) {{
    return d3.drag()
      .on("start", function(event, d) {{
        if (!event.active) simulation.alphaTarget(0.3).restart();
        d.fx = d.x;
        d.fy = d.y;
      }})
      .on("drag", function(event, d) {{
        d.fx = event.x;
        d.fy = event.y;
      }})
      .on("end", function(event, d) {{
        if (!event.active) simulation.alphaTarget(0);
        d.fx = null;
        d.fy = null;
      }});
  }}

  function filterAttackSurface(type) {{
    document.querySelectorAll("#attack-surface-map .viz-btn").forEach(b => b.classList.remove("active"));
    event.target.classList.add("active");
    
    const nodeSelection = d3.select("#attack-surface-map svg").selectAll(".node");
    const linkSelection = d3.select("#attack-surface-map svg").selectAll(".link");
    
    if (type === "all") {{
      nodeSelection.style("opacity", 1).style("display", null);
      linkSelection.style("opacity", 1).style("display", null);
    }} else {{
      nodeSelection.style("opacity", d => d.kind === type ? 1 : 0.1)
        .style("display", d => d.kind === type ? null : "none");
      linkSelection.style("opacity", d => d.source.kind === type || d.target.kind === type ? 1 : 0.1)
        .style("display", d => d.source.kind === type || d.target.kind === type ? null : "none");
    }}
  }}

  window.filterAttackSurface = filterAttackSurface;
}}

function buildAttackSurfaceNodes(results) {{
  const nodes = [];
  const nodeMap = new Map();

  // Target node
  nodes.push({{
    id: "target",
    label: "{}",
    kind: "target",
    label_full: "{}",
    x: 0, y: 0, fx: 0, fy: 0,
    degree: 0
  }});
  nodeMap.set("target", nodes.length - 1);

  // Subdomains
  {}.forEach((sub, i) => {{
    const id = `sub-${{i}}`;
    nodes.push({{
      id,
      label: sub.name,
      kind: "subdomain",
      label_full: sub.name,
      ips: sub.ips,
      source: sub.source,
      degree: 0
    }});
    nodeMap.set(id, nodes.length - 1);
  }});

  // Open ports / services
  {}.forEach((p, i) => {{
    if (p.open) {{
      const kind = [80, 443, 8080, 8443, 8080, 3000, 5000, 8000, 8081].includes(p.port) ? "web" :
                   [21, 22, 23, 25, 110, 143, 993, 995, 465, 587].includes(p.port) ? "infra" :
                   [3306, 5432, 1433, 27017, 6379, 11211].includes(p.port) ? "db" :
                   [389, 636, 3268].includes(p.port) ? "ldap" :
                   [445, 139].includes(p.port) ? "smb" :
                   [161, 162].includes(p.port) ? "snmp" :
                   [22, 3389, 5900, 5901].includes(p.port) ? "remote" : "service";
      
      nodes.push({{
        id: `port-${{p.port}}`,
        label: `${{p.port}}/${{p.service}}`,
        kind,
        label_full: `${{p.service}} (${{p.product || "?"}} ${{p.version || "?"}})`,
        port: p.port,
        service: p.service,
        product: p.product,
        version: p.version,
        degree: 0
      }});
    }}
  }});

  // Vulnerabilities
  {}.forEach((v, i) => {{
    nodes.push({{
      id: `vuln-${{i}}`,
      label: v.title.length > 25 ? v.title.substring(0, 22) + "…" : v.title,
      kind: "vuln",
      label_full: v.title,
      severity: v.severity,
      cve: v.cve,
      affected: v.affected,
      confidence: v.confidence,
      description: v.description,
      evidence: v.evidence,
      degree: 0
    }});
  }});

  // API endpoints
  {}.forEach((ep, i) => {{
    nodes.push({{
      id: `api-${{i}}`,
      label: `${{ep.method}} ${{ep.path}}`,
      kind: "api",
      label_full: `${{ep.method}} ${{ep.path}} (${{ep.api_type}})`,
      method: ep.method,
      path: ep.path,
      api_type: ep.api_type,
      auth_required: ep.auth_required,
      degree: 0
    }});
  }});

  // Credentials
  {}.forEach((c, i) => {{
    nodes.push({{
      id: `cred-${{i}}`,
      label: c.title || "Credential",
      kind: "cred",
      label_full: c.description,
      severity: c.severity,
      cve: c.cve,
      evidence: c.evidence,
      degree: 0
    }});
  }});

  // Calculate degrees
  const links = [];
  nodes.forEach((n, i) => {{
    if (n.kind === "subdomain" || n.kind === "target") {{
      links.push({{source: n.id, target: "target", type: "recon"}});
      if (nodes[0]) nodes[0].degree = (nodes[0].degree || 0) + 1;
      n.degree = (n.degree || 0) + 1;
    }}
    if (n.kind === "vuln" && n.affected) {{
      const portNode = Array.from(new Set().add(...nodes.filter(x => x.kind === "service" || x.kind === "web" || x.kind === "api" || x.kind === "db" || x.kind === "infra" || x.kind === "remote" || x.kind === "ldap" || x.kind === "smb" || x.kind === "snmp").map(x => x.id))).find(id => {{
        // Simplified matching
        return false;
      }});
      if (portNode) {{
        links.push({{source: portNode, target: n.id, type: "exploit"}});
      }}
    }}
  }});

  return nodes;
}

function buildAttackSurfaceLinks(results) {{
  const links = [];
  // Target -> Subdomains
  {}.forEach((sub, i) => {{
    links.push({{source: "target", target: `sub-${{i}}`, type: "recon"}});
  }});
  // Subdomains -> Open ports on that subdomain (simplified)
  // Vulnerabilities -> Affected services
  {}.forEach((v, i) => {{
    // Link vuln to affected port/service if possible
  }});
  return links;
}
</script>"#, 
        html_escape(&results.target.input),
        html_escape(&results.target.input),
        serde_json::to_string(&results.subdomains).unwrap_or_default(),
        serde_json::to_string(&results.ports).unwrap_or_default(),
        serde_json::to_string(&results.vulns).unwrap_or_default(),
        serde_json::to_string(&results.api_endpoints).unwrap_or_default(),
        serde_json::to_string(&results.vulns).unwrap_or_default(),
    );

    h
}